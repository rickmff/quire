// Cloudflare Workers config. Read by Workers Builds for main and for preview branches.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quire",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Wrangler runs this before `deploy` and `versions upload`,
  // so the worker exists whatever the dashboard build command is.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "observability": { "enabled": true }
}

{
  "manifest_version": 3,
  "name": "quire",
  "version": "0.1.0",
  "description": "Save the component you are looking at to quire.",
  "action": { "default_title": "Save to quire" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "storage"],
  "options_page": "options.html",
  "icons": { "128": "icon.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Save this page to quire"
    }
  }
}
